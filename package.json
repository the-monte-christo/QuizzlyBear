{
  "name": "quizzlybear",
  "version": "0.1.0",
  "private": true,
  "description": "QuizzlyBear – Live-Quiz für Kollegenrunden (Host-Screen, Handy-Spieler, Quizmaster)",
  "type": "module",
  "license": "Unlicense",
  "engines": {
    "node": "^22.23.5 || ^24.22.3 || >=26.13.1"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --clear-screen=false src/server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:schema && npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "build:schema": "tsx scripts/build-schema.ts",
    "build:assets": "node scripts/build-assets.mjs",
    "start": "node dist/server/index.js",
    "check": "tsc --noEmit -p tsconfig.json && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "user:add": "tsx scripts/user-add.ts",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "better-sqlite3": "^12.4.1",
    "express": "^5.1.0",
    "fflate": "^0.8.2",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@fontsource-variable/fredoka": "^5.2.8",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^24.9.1",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.11",
    "playwright-core": "^1.56.1",
    "qrcode-generator": "^2.0.4",
    "socket.io-client": "^4.8.1",
    "svelte": "^5.41.0",
    "svelte-check": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.11",
    "vitest": "^5.1.2"
  }
}
